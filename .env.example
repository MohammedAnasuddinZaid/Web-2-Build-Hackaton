# Copy to .env.local for local dev, or add in Vercel: Settings -> Environment Variables.

# Cross-instance session store — REQUIRED for multi-device sync on Vercel.
# Free tier: https://upstash.com -> Create database (Regional, REST) -> copy both values.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Shared secret for the IoT ingest endpoint (/api/ingest). Must match DEVICE_TOKEN
# in firmware/carespeak_esp32.ino. Leave empty for open demo mode.
CARESPEAK_DEVICE_TOKEN=

# ---------------------------------------------------------------------------
# Web Voice Call — Demo (browser-to-browser WebRTC care calls, Vercel-first)
# ---------------------------------------------------------------------------
# Nurse sign-in. CHANGE THESE before any real use. Defaults to nurse.demo/nurse.demo.
CARE_NURSE_USER=
CARE_NURSE_PASS=
CARE_NURSE_NAME=
# Optional administrator account.
CARE_ADMIN_USER=
CARE_ADMIN_PASS=
# Public base URL used to build QR join links (no trailing slash). Optional on Vercel
# (auto-detected from the request host), required behind some proxies.
NEXT_PUBLIC_CARESPEAK_URL=
# TURN relay fallback (needed when peer-to-peer connectivity fails). Optional but
# recommended across mobile networks. Get free/cheap credentials from any TURN provider.
CARE_TURN_URL=
CARE_TURN_USERNAME=
CARE_TURN_CREDENTIAL=
# Session/link tuning.
CARE_JOIN_TTL_MINUTES=30
CARE_MAX_SESSION_MINUTES=30
CARE_SIGNAL_POLL_MS=1200
# On-device AI model overrides (optional).
CARE_ASR_MODEL=Xenova/whisper-tiny.en
CARE_LLM_MODEL=Llama-3.2-1B-Instruct-q4f16_1-MLC
# Force a store driver: redis | file | memory (default: auto).
CARE_STORE=
# Set to false to skip the one-time synthetic demo sessions/messages.
CARE_SEED_DEMO=

# ---------------------------------------------------------------------------
# Nurse-portal assistant (patient records intake + live talking AI)
# ---------------------------------------------------------------------------
# Gemini key used ONLY server-side, to answer questions the deterministic engine
# cannot and to phrase spoken alerts. Leave empty to run on rules alone.
GEMINI_API_KEY=
# Optional: override the primary model, or set a different model per mode.
# Default fast cascade: gemini-flash-lite-latest -> 2.5-flash-lite -> 2.0-flash-lite.
# Default deep cascade: gemini-2.5-flash -> flash-latest -> 2.0-flash -> fast models.
GEMINI_MODEL=
GEMINI_FAST_MODEL=
GEMINI_DEEP_MODEL=

# ---------------------------------------------------------------------------
# Phone alerts — real Twilio voice calls (emergency + demo "call me" button)
# ---------------------------------------------------------------------------
# Create a free Twilio account: https://console.twilio.com
# From the console's Account Info panel copy the Account SID and Auth Token.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio number calls will come FROM, in E.164 (e.g. +12025550123).
# Defaults to the CareSpeak alert line (+919908786211) when left empty.
# A free trial number works; on a trial the destination must also be VERIFIED
# in the Twilio console (Phone Numbers -> Verified Caller IDs) and Twilio plays
# a short trial preamble before the agent speaks.
TWILIO_FROM_NUMBER=+919908786211
# Who is phoned on an emergency. Comma/semicolon separated. Bare 10-digit
# Indian numbers are normalised to +91. Defaults to +919849130407 when unset.
CARE_EMERGENCY_PHONE=+919849130407
# Secret appended to the TwiML webhook URL. Optional: when unset, a stable
# secret is derived from TWILIO_AUTH_TOKEN. Set it if you rotate credentials.
CARE_VOICE_SECRET=
# Public HTTPS base URL Twilio can fetch the call script from (no trailing
# slash). On Vercel this is auto-detected; locally set a tunnel (e.g. cloudflared).
CARE_VOICE_BASE_URL=
# Set to 1 ONLY to allow dialing from a non-public URL (e.g. local testing with
# Twilio's own reachable tunnel). Left unset, the server refuses insecure dials.
CARE_VOICE_ALLOW_INSECURE=
